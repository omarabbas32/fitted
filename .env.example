# Copy to .env and fill in. Never commit .env — it is gitignored.

# MySQL connection string. Create the database first (or let `npm run db:migrate` do it).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/fitted"

# Fallback AI config. The in-app Settings dialog overrides all three and stores
# them in the Setting table, so you can leave these blank and configure the app
# from the UI on first run.
AGENTROUTER_BASE_URL="https://agentrouter.org/v1"
AGENTROUTER_API_KEY=""
DEFAULT_MODEL="claude-sonnet-5"
